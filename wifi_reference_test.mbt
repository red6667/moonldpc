// Pinned vectors in tests/fixtures/wifi1944-r34.json; verified by scripts/check_wifi.py.
// Fixtures originate from pinned MIT sources; see docs/wifi-compatibility.md.

///|
fn wifi_bits(text : String) -> Array[Int32] {
  text.to_array().map(fn(c) { if c == '1' { 1 } else { 0 } })
}

///|
test "Wi-Fi external reference complete codewords and systematic order" {
  let wifi = @moonldpc.WifiLdpc1944R34::new()
  let code = wifi.parity_check()
  assert_eq(code.variables(), 1944)
  assert_eq(code.checks(), 486)
  let cases : Array[(String, String)] = [
    // annex-g-example-1
    (
      "",
      "",
    ),
    // zero
    (
      "",
      "",
    ),
    // ones
    (
      "",
      "",
    ),
    // alternating
    (
      "",
      "",
    ),
    // first
    (
      "",
      "",
    ),
    // last
    (
      "",
      "",
    ),
    // stride-17
    (
      "",
      "",
    ),
  ]
  for (input, expected) in cases {
    let information = wifi_bits(input)
    let word = wifi.encode(information)
    assert_eq(word, wifi_bits(expected))
    assert_eq(wifi.extract(word), information)
    assert_true(code.is_codeword(word))
  }
}

///|
test "Wi-Fi full lifted matrix matches two external code tables" {
  let base : Array[Array[Int32]] = [
    [
      48, 29, 28, 39, 9, 61, -1, -1, -1, 63, 45, 80, -1, -1, -1, 37, 32, 22, 1, 0,
      -1, -1, -1, -1,
    ],
    [
      4, 49, 42, 48, 11, 30, -1, -1, -1, 49, 17, 41, 37, 15, -1, 54, -1, -1, -1,
      0, 0, -1, -1, -1,
    ],
    [
      35, 76, 78, 51, 37, 35, 21, -1, 17, 64, -1, -1, -1, 59, 7, -1, -1, 32, -1,
      -1, 0, 0, -1, -1,
    ],
    [
      9, 65, 44, 9, 54, 56, 73, 34, 42, -1, -1, -1, 35, -1, -1, -1, 46, 39, 0, -1,
      -1, 0, 0, -1,
    ],
    [
      3, 62, 7, 80, 68, 26, -1, 80, 55, -1, 36, -1, 26, -1, 9, -1, 72, -1, -1, -1,
      -1, -1, 0, 0,
    ],
    [
      26, 75, 33, 21, 69, 59, 3, 38, -1, -1, -1, 35, -1, 62, 36, 26, -1, -1, 1, -1,
      -1, -1, -1, 0,
    ],
  ]
  let code = @moonldpc.WifiLdpc1944R34::new().parity_check()
  for r in 0..<486 {
    let expected : Array[Int32] = []
    for c, shift in base[r / 81] {
      if shift >= 0 {
        expected.push(c * 81 + (r % 81 + shift) % 81)
      }
    }
    assert_eq(code.check_variables(r), expected)
  }
}

///|
test "Wi-Fi Annex G shortening puncturing and restored decoder input" {
  let wifi = @moonldpc.WifiLdpc1944R34::new()
  let information = wifi_bits(
    "",
  )
  let word = wifi.encode(information)
  // Annex G example 1 only: 816 data bits, 642 shortened zeros, 54 tail punctures.
  let transmitted = Array::makei(1248, fn(i) {
    if i < 816 {
      i
    } else {
      1458 + i - 816
    }
  })
  let shortened = Array::makei(642, fn(i) { (816 + i, 0) })
  let plan = @moonldpc.RatePlan::new(1944, transmitted, shortened~)
  let expected = wifi_bits(
    "",
  )
  assert_eq(plan.project(word), expected)
  assert_eq(plan.punctured_positions(), Array::makei(54, fn(i) { 1890 + i }))
  let llr = plan.restore_llr(
    expected.map(fn(bit) { if bit == 0 { 8.0 } else { -8.0 } }),
  )
  for
    algorithm in [
      @moonldpc.SumProduct,
      @moonldpc.MinSum,
      @moonldpc.LayeredMinSum,
    ] {
    let result = wifi
      .parity_check()
      .decode(llr, @moonldpc.DecoderConfig::new(algorithm, iterations=50))
    assert_true(result.converged)
    assert_eq(result.word, word)
    assert_true(plan.accepts(result.word))
    assert_eq(wifi.extract(result.word), information)
  }
}
